# Which data adapter the app uses: "http" (real Python API) or "mock" (in-browser demo data).
# Never ship a production build with "mock".
VITE_API_MODE=http

# Base URL of the Python API. Relative paths work with the dev proxy below or a reverse proxy.
VITE_API_BASE_URL=/api

# Dev only: forward /api from the Vite dev server to the backend (avoids CORS while developing).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8010

# Do not put secrets here. Every VITE_* variable is embedded in the public JavaScript bundle.
